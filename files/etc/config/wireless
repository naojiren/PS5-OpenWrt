config wifi-device 'radio0'
    option type 'mac80211'
    option phy 'mwiphy0'
    option country 'CN'
    option band '5g'
    option channel '36'
    option htmode 'HE80'
    option disabled '0'

config wifi-iface 'default_radio0'
    option device 'radio0'
    option network 'lan'
    option mode 'ap'
    option ssid 'PS5-OpenWrt'
    option encryption 'none'
    option disabled '0'
