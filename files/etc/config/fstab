config global
    option anon_swap '0'
    option anon_mount '0'
    option auto_swap '0'
    option auto_mount '1'
    option delay_root '5'
    option check_fs '0'

config mount 'ps5_boot'
    option target '/boot/efi'
    option label 'boot'
    option fstype 'vfat'
    option options 'ro,noatime'
    option enabled '1'
    option enabled_fsck '0'
