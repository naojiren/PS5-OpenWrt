-/* no hw filter wired up yet, just log what got asked for */
+static u32 gbe_mc_hash(const u8 *addr)
+{
+	u8 rev[ETH_ALEN];
+	u32 crc;
+	int i;
+
+	for (i = 0; i < ETH_ALEN; i++)
+		rev[i] = bitrev8(addr[i]);
+
+	crc = crc32_be(~0, rev, ETH_ALEN);
+	return (crc & 7) + (crc >> 27) * 8;
+}
